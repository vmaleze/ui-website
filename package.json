{
  "name": "@ippon-ui/website",
  "version": "0.0.1",
  "private": true,
  "description": "Ippon UI website — exposes every published version of the Pattern Library on GitHub Pages",
  "type": "module",
  "scripts": {
    "build": "node src/main.ts",
    "dev": "http-server public --port 4290 -c-1",
    "lint": "tsc --noEmit",
    "lint:ci": "tsc --noEmit",
    "format": "prettier . --write",
    "format:ci": "prettier . --check",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "prepare": "[ -n \"$CI\" ] || lefthook install"
  },
  "keywords": [
    "ui",
    "pattern library",
    "design system"
  ],
  "author": "Ippon Technologies",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "semver": "7.8.5",
    "tar": "7.5.19"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/semver": "7.7.1",
    "http-server": "14.1.1",
    "lefthook": "2.1.9",
    "prettier": "3.9.4",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
